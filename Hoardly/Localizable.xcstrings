    "Open Hoardly": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Hoardly"
          }
        }
      }
    },
    "Open Hoardly at login": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Hoardly saat login"
          }
        }
