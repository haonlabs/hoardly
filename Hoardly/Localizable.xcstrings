      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Antre"
          }
        }
      }
    },
    "Queued & Paused": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Antre & Dijeda"
          }
        }
      }
    },
    "Quit": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar"
          }
        }
      }
