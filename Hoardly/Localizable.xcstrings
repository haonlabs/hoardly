      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %lld unduhan?"
          }
        }
      }
    },
    "Remove from List": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus dari Daftar"
          }
        }
      }
    },
    "Remove…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus…"
          }
        }
      }
    },
    "Resume": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan"
          }
        }
      }
    },
    "Save to": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan ke"
          }
        }
      }
    },
    "Set Up Browsers…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur Browser…"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan di Finder"
          }
        }
      }
    },
    "Simultaneous downloads: %lld": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan bersamaan: %lld"
          }
        }
      }
    },
    "Size": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran"
          }
        }
      }
    },
    "Sort into category folders (Video, Music, Archives…)": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelompokkan ke folder kategori (Video, Music, Archives…)"
          }
        }
      }
    },
    "Speed": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan"
          }
        }
      }
    },
    "Start Download": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai Unduh"
          }
        }
      }
    },
    "Starting…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai…"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "Take over files of type": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil alih file berjenis"
          }
        }
      }
    },
    "The Hoardly extension in %@ will send downloads here. Only allow this if you just installed or reset the extension.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstensi Hoardly di %@ akan mengirim unduhan ke sini. Izinkan hanya jika Anda baru saja memasang atau mengatur ulang ekstensinya."
          }
        }
      }
    },
    "The first time a browser's extension reaches Hoardly, a dialog asks you to connect it. Click Connect.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ekstensi di sebuah browser pertama kali menghubungi Hoardly, muncul dialog untuk menghubungkannya. Klik Hubungkan."
          }
        }
      }
    },
    "Time Left": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisa Waktu"
          }
        }
      }
    },
    "Turn On in Safari…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan di Safari…"
          }
        }
      }
    },
    "Turned on": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif"
          }
        }
      }
    },
    "Unfinished downloads lose their partial data.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data unduhan yang belum selesai akan hilang."
          }
        }
      }
    },
    "Video": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video"
          }
        }
      }
    },
    "Welcome to Hoardly": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang di Hoardly"
          }
        }
      }
    },
    "your browser": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "browser Anda"
          }
        }
      }
    },
    "…and any file over %lld MB": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "…dan file apa pun di atas %lld MB"
          }
        }
      }
    },
    "…and any file: off": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "…dan file apa pun: nonaktif"
          }
        }
      }
    }
