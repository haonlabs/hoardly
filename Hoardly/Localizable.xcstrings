{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "1. Add Hoardly to your browsers": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tambahkan Hoardly ke browser Anda"
          }
        }
      }
    },
    "2. Connect": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Hubungkan"
          }
        }
      }
    },
    "3. Stay ready": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Selalu siap"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua"
          }
        }
      }
    },
    "Archives": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsip"
          }
        }
      }
    },
    "Ask before starting downloads sent from the browser": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya dulu sebelum memulai unduhan dari browser"
          }
        }
      }
    },
    "Bridge failed: %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi browser gagal: %@"
          }
        }
      }
    },
    "Browser downloads": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan browser"
          }
        }
      }
    },
    "Browsers": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser"
          }
        }
      }
    },
    "Browsers can only hand downloads to Hoardly while it's running; otherwise they download as usual.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser hanya bisa menyerahkan unduhan ke Hoardly saat Hoardly berjalan; jika tidak, browser mengunduh seperti biasa."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batal"
          }
        }
      }
    },
    "Categories": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa Pembaruan…"
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih…"
          }
        }
      }
    },
    "Completed": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan"
          }
        }
      }
    },
    "Connect %@ to Hoardly?": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan %@ ke Hoardly?"
          }
        }
      }
    },
    "Connections per download: %lld": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi per unduhan: %lld"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin"
          }
        }
      }
    },
    "Copy Address": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salin Alamat"
          }
        }
      }
    },
    "Documents": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumen"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesai"
          }
        }
      }
    },
    "Don’t Allow": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan Izinkan"
          }
        }
      }
    },
    "Download Later": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh Nanti"
          }
        }
      }
    },
    "Download addresses, one per line": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat unduhan, satu per baris"
          }
        }
      }
    },
    "Download complete": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan selesai"
          }
        }
      }
    },
    "Download failed": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan gagal"
          }
        }
      }
    },
    "Download folder": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder unduhan"
          }
        }
      }
    },
    "Downloading": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal"
          }
        }
      }
    },
    "Faster, resumable downloads from every browser.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan lebih cepat dan bisa dilanjutkan, dari browser apa pun."
          }
        }
      }
    },
    "File name": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama file"
          }
        }
      }
    },
    "Files": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Umum"
          }
        }
      }
    },
    "Get Extension": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang Ekstensi"
          }
        }
      }
    },
    "Hold ⌥ Option while clicking a link to let the browser download it instead.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan ⌥ Option saat mengeklik tautan agar browser yang mengunduhnya."
          }
        }
      }
    },
    "Listening on 127.0.0.1:%lld": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap di 127.0.0.1:%lld"
          }
        }
      }
    },
    "Move Files to Trash": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan File ke Tong Sampah"
          }
        }
      }
    },
