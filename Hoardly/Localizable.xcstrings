    "Other": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lainnya"
          }
        }
      }
    },
    "Pairing token": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token pemasangan"
          }
        }
      }
    },
    "Paste the token into the Hoardly extension's settings in Safari, Chrome, Helium or Firefox.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel token ke pengaturan ekstensi Hoardly di Safari, Chrome, Helium, atau Firefox."
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda"
          }
        }
      }
    },
    "Paused · %@": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijeda · %@"
          }
        }
      }
    },
    "Programs": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Program"
          }
        }
      }
    },
    "Progress": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Progres"
          }
        }
      }
